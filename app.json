{
  "expo": {
    "name": "Robot Savo Copilot",
    "slug": "robot-savo-copilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "robotsavocopilot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050816",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.robotsavo.copilot",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Robot Savo Copilot connects to your SavoMind server on the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#050816"
      },
      "package": "com.robotsavo.copilot",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Robot Savo Copilot to record voice messages for SavoMind."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
